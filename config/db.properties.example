# ============================================================================
# Disaster Management and Emergency Response System
# Database Configuration Properties Template (Example)
# Rename this file to db.properties and set your MySQL credentials
# ============================================================================

db.host=localhost
db.port=3306
db.database=disaster_management_db
db.username=root
db.password=your_mysql_password_here

# Connection Pool / Driver Settings
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/disaster_management_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# Application Settings
app.title=Disaster Management & Emergency Response System
app.version=1.0.0
app.debug=true
